{
  // ============================================================
  // OpenClaw 完整配置（JSONC：// 注释会被忽略，可放心保留）
  // 顶层结构：
  //   meta/wizard    记录性元数据（不影响行为）
  //   auth           认证档案（mode：api_key | token | oauth | none）
  //   models         模型提供商与模型目录（协议/定价/窗口/兼容参数）
  //   agents         ★多 agent：defaults=共享基线，entries=各 agent（继承/覆盖 defaults）
  //   tools          工具档案（profile）与搜索/执行/白名单
  //   bindings       渠道账号 → agent 路由
  //   messages       消息确认表情作用域
  //   commands       内置命令开关
  //   session        会话隔离维度
  //   channels       各渠道接入（telegram/feishu）
  //   gateway        本地网关（端口/模式/认证/节点限制）
  //   skills         技能库全局启停
  //   plugins        插件启停与配置
  // ============================================================
  // meta：元信息（记录性，不影响运行）
  "meta": {
    "lastTouchedVersion": "2026.7.1-2", // 最后写入此文件的 OpenClaw 版本
    "lastTouchedAt": "2026-07-27T05:22:23.859Z" // 最后改动时间（UTC）
  },
  // wizard：安装/诊断向导最近运行记录（记录性）
  "wizard": {
    "lastRunAt": "2026-07-21T16:38:59.925Z",
    "lastRunVersion": "2026.7.1-2",
    "lastRunCommand": "doctor", // 最近执行命令：onboard | doctor | setup ...
    "lastRunMode": "local" // 运行模式：local | remote
  },
  // auth：认证档案（键格式 <provider>:<profileId>）
  //   mode 可取值：api_key | token | oauth | none
  "auth": {
    "profiles": {
      "zai:default": {
        "provider": "zai", // 对应 models.providers 中的提供商
        "mode": "api_key" // api_key：静态密钥
      },
      "deepseek:default": {
        "provider": "deepseek",
        "mode": "api_key"
      }
    }
  },
  // models：模型提供商与模型目录
  //   mode 可取值：merge（与内置默认合并）| override（整体覆盖默认表）
  //   providers.<id>.api 可取值：openai-completions | openai-responses | anthropic-messages | claude | custom ...
  "models": {
    "mode": "merge",
    "providers": {
      "deepseek": {
        "baseUrl": "https://api.deepseek.com", // API 端点
        "api": "openai-completions", // 协议：OpenAI 兼容 completions
        "models": [
          {
            // 模型项字段说明：
            //   id            模型标识（agents.*.model 用 provider/id 引用）
            //   name          展示名
            //   reasoning     是否推理型模型
            //   input         输入模态：text | image | audio ...
            //   cost          每百万 token 美元单价（input/output/cacheRead/cacheWrite）
            //   contextWindow 上下文窗口 token 数
            //   maxTokens     单次最大输出 token
            //   compat        兼容参数：supportsReasoningEffort 推理力度；supportsUsageInStreaming 流式用量；maxTokensField 请求中 max tokens 字段名
            "id": "deepseek-v4-flash",
            "name": "DeepSeek V4 Flash",
            "reasoning": true,
            "input": [ "text" ],
            "cost": {
              "input": 0.14, // 输入单价（美元/百万 token）
              "output": 0.28, // 输出单价
              "cacheRead": 0.028, // 缓存命中读取单价
              "cacheWrite": 0 // 缓存写入单价
            },
            "contextWindow": 1000000,
            "maxTokens": 384000,
            "compat": {
              "supportsReasoningEffort": true,
              "supportsUsageInStreaming": true,
              "maxTokensField": "max_tokens"
            },
            "api": "openai-completions"
          },
          {
            "id": "deepseek-v4-pro",
            "name": "DeepSeek V4 Pro",
            "reasoning": true,
            "input": [ "text" ],
            "cost": {
              "input": 1.74,
              "output": 3.48,
              "cacheRead": 0.145,
              "cacheWrite": 0
            },
            "contextWindow": 1000000,
            "maxTokens": 384000,
            "compat": {
              "supportsReasoningEffort": true,
              "supportsUsageInStreaming": true,
              "maxTokensField": "max_tokens"
            },
            "api": "openai-completions"
          }
        ]
      }
    }
  },

  // ============================================================
  // 多 Agent 支持：defaults 提供共享基线，entries 定义各 agent 并继承/覆盖
  // ============================================================
  "agents": {
    // agents.defaults：所有 agent 的共享基线（entries 中省略的字段继承这里）
    "defaults": {
      // model：主模型 + 回退链；可简写为字符串 "provider/model"（仅主模型）
      "model": {
        "primary": "deepseek/deepseek-v4-pro",
        // 修正：原 fallback 指向未定义的 custom-api-deepseek-com 提供商，改为同提供商内的 flash
        "fallbacks": [ "deepseek/deepseek-v4-flash" ]
      },
      // models：模型别名表（UI/渠道展示用友好名称；键为 provider/model）
      "models": {
        "deepseek/deepseek-v4-flash": { "alias": "DeepSeek-V4-Flash" },
        // 修正：原键名大小写不一致（V4-Pro），与 primary 对齐为小写
        "deepseek/deepseek-v4-pro": { "alias": "DeepSeek-V4-Pro" }
      },
      "workspace": "/Users/chuliang/.openclaw/workspace", // 默认工作区（文件操作根目录）
      // compaction：上下文压缩策略
      //   mode 可取值：default（整体摘要）| safeguard（分块摘要，长历史更稳）
      //   reserveTokensFloor 压缩时至少保留的 token 数
      "compaction": {
        "mode": "default",
        "reserveTokensFloor": 40000
      },
      "maxConcurrent": 4, // 主 agent 并发会话上限
      "subagents": {
        "maxConcurrent": 8 // 单个 agent 可派生子 agent 并发上限
      },
      // reasoningDefault：推理展示方式 off（不显示）| on（生成后附带）| stream（实时流式）
      "reasoningDefault": "stream",
      // toolProgressDetail：工具进度详细度 explain（简洁）| raw（附具体命令细节）
      "toolProgressDetail": "explain",
      // 共享技能基线：未设置 agents.entries.*.skills 的 agent 继承它（[]=禁用；省略=不限制）
      "skills": [ "coding-agent" ]
    },

    "entries": {
      // agents.entries.*：各 agent 定义
      //   继承规则：省略的字段继承 defaults；skills 为显式替换（不合并）
      //   字段：default（唯一 true 为默认 agent）| name | workspace | model
      //         identity{name,emoji,theme} | skills[] | tools{profile|allow|deny}
      // 默认 agent：未覆盖的字段全部继承 defaults
      "main": {
        "default": true, // 有且仅有一个默认 agent
        "name": "Main Assistant",
        "workspace": "/Users/chuliang/.openclaw/workspace",
        "identity": {
          "name": "Clawd",
          "emoji": "🦞", // 用于确认表情 ackReaction 等
          "theme": "helpful assistant"
        },
        "skills": [ "coding-agent" ],
        "reasoningDefault": "stream"
      },

      // 编码 agent：覆盖模型为快速低延迟的 flash，工作区独立
      "coding": {
        "name": "Coding Agent",
        "workspace": "/Users/chuliang/.openclaw/workspace-coding",
        "model": "deepseek/deepseek-v4-flash", // 覆盖 defaults 主模型
        "skills": [ "coding-agent" ],
        // tools.profile 可取值：full | minimal | coding | messaging
        "tools": {
          "profile": "coding"
        }
      },

      // 社交 agent：显式空技能列表（禁用技能），仅保留消息/会话能力
      "social": {
        "name": "Social Agent",
        "workspace": "/Users/chuliang/.openclaw/workspace-social",
        "skills": [], // 显式空列表 = 禁用所有技能
        "tools": {
          "allow": [ "message", "session" ] // 工具白名单：仅消息与会话
        }
      }
    }
  },

  // tools：工具策略
  //   profile 可取值：full | minimal | coding | messaging
  //   web.search.provider 可取值：brave | google | tavily | duckduckgo | serper | bing ...
  //   exec.security 可取值：full | workspace-only | sandbox ...
  //   exec.ask 可取值：off（不询问）| on（每次询问）| allowlist（白名单内不问）
  "tools": {
    "profile": "full",
    "web": {
      "search": {
        "enabled": true,
        "provider": "brave"
      }
    },
    "exec": {
      "host": "gateway",
      "security": "full",
      "ask": "off"
    },
    "allow": [ // 全局允许的工具：exec|read|write|edit|apply_patch|message|session|browser|process|cron|nodes ...
      "exec",
      "read",
      "write",
      "message",
      "session"
    ]
  },

  // bindings：多 agent 路由（把渠道账号路由到对应 agent）
  //   match.accountId 可取值：default（仅默认账号）| *（渠道内任意账号）| 具体账号名
  //   match.peer（可选）可精确到对端：{ kind: direct|group|channel, id }
  "bindings": [
    { "agentId": "main",   "match": { "channel": "feishu",   "accountId": "default" } },
    { "agentId": "main",   "match": { "channel": "telegram", "accountId": "*" } },
    { "agentId": "coding", "match": { "channel": "telegram", "accountId": "*" } }
  ],

  // messages：消息行为
  //   ackReactionScope 可取值：group-mentions | group-all | direct | all | off/none
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  // commands：内置命令
  //   native / nativeSkills：auto（自动启用）| off
  //   ownerDisplay：raw（原始格式）| plain ...
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  // session：会话隔离维度
  //   dmScope 可取值：main | per-peer | per-channel-peer | per-account-channel-peer
  "session": {
    "dmScope": "per-channel-peer"
  },
  // channels：渠道接入
  "channels": {
    "telegram": {
      "enabled": true,
      // dmPolicy 可取值：pairing（需配对批准）| allowlist（白名单）
      "dmPolicy": "pairing",
      "botToken": "8719859911:AAHlvTgjW3skT_A3Phbz3C5xXiXwXu9KzIE", // ⚠️ 明文令牌，建议轮换
      "allowFrom": [], // 允许发起私聊的来源白名单
      // groupPolicy 可取值：allowlist | open
      "groupPolicy": "allowlist",
      // streaming.mode 可取值：partial（边生成边发）| full | off
      "streaming": {
        "mode": "partial",
        "chunkMode": "length" // 切块方式：length | sentence | ...
      },
      "actions": { // 启用的动作能力
        "reactions": true,
        "sendMessage": true,
        "poll": true,
        "sticker": true
      }
    },
    "feishu": {
      "enabled": true,
      "appId": "cli_a93bbe08147a5cee",
      "appSecret": "Zh6iwfvncvbTDs4LeAJrp5FPZdwYjOaD", // ⚠️ 明文密钥，建议轮换
      // connectionMode 可取值：websocket（长连接）| webhook | long-polling
      "connectionMode": "websocket",
      "domain": "feishu",
      "groupPolicy": "allowlist",
      "capabilities": [ // 向 agent 暴露的能力
        "message",
        "exec",
        "read",
        "write"
      ],
      "streaming": true
    }
  },
  // gateway：本地网关
  //   mode 可取值：local（仅本机）| remote
  //   bind 可取值：loopback（仅回环）| 0.0.0.0 ...
  //   auth.mode 可取值：token | none | oauth
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "48ae6668c8e108a5fe59d1b2271adcbfd11a327cb19e224b" // ⚠️ 网关令牌，建议轮换
    },
    // tailscale.mode：off | on
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    // nodes.denyCommands：禁用的敏感节点命令
    "nodes": {
      "denyCommands": [
        "camera.snap",
        "camera.clip",
        "screen.record",
        "contacts.add",
        "calendar.add",
        "reminders.add",
        "sms.send"
      ]
    }
  },
  // skills.entries：技能库全局启停（键=技能 id，enabled=true 可用 / false 禁用）
  // 与 agents.entries.*.skills（agent 级白名单）叠加过滤
  "skills": {
    "entries": {
