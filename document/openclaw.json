  // plugins.entries：插件启停与配置（键=插件 id，enabled 是否启用）
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      },
      "feishu": {
        "enabled": true
      },
      "brave": {
        "config": {
          "webSearch": {
            "apiKey": "adsasf" // ⚠️ 示例 Key，请替换为真实 Key
          }
        },
